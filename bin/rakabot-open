#!/usr/bin/env python3
# rakabot-open - open Rakazo the way this machine already uses it, and, when
# asked, switch the window that is already open to one bot.
#
#   rakabot-open [--prefer auto|web-app|browser] [--select NAME] [--pattern P]... <url>
#
# auto (the default) tries three things in order:
#   1. focus a window that is already showing the server - an Omarchy web app
#      (Chrome app windows report a class like chrome-<host>-...), the Rakazo
#      desktop app, or a browser window titled after it
#   2. otherwise launch the installed web app launcher for that address, if there
#      is one (~/.local/share/applications/*.desktop)
#   3. otherwise open the address in the default browser
#
# --prefer browser jumps straight to 3. --prefer web-app skips 3 and opens a web
# app window even when no launcher is installed.
#
# --select NAME additionally switches the window that was focused to that bot,
# through the app's own command palette (Ctrl+K, type the name, Enter). Rakazo
# keeps the open bot in its address (/app/<botId>) but a running app window cannot
# be navigated from outside, so the palette is the way in. The keystrokes are only
# sent when the server's own window is verifiably focused - never into whatever
# happens to be in front.
#
# Prints one line saying what it did, so a log tells the whole story.
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.parse

APPLICATIONS = "~/.local/share/applications"
DESKTOP_APP_CLASSES = ("rakazo", "rakazo-desktop")
KEYSTROKE_GAP = 0.25


def applications_dir():
    return os.path.expanduser(os.environ.get("RAKABOT_APPLICATIONS") or APPLICATIONS)


def host_of(url):
    parsed = urllib.parse.urlparse(url if "://" in url else "https://" + url)
    return (parsed.hostname or "").lower()


def windows():
    """Every open window, as Hyprland reports it. Empty when it cannot answer."""
    if not shutil.which("hyprctl"):
        return []
    try:
        result = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=10)
        clients = json.loads(result.stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    return clients if isinstance(clients, list) else []


def find_window(clients, patterns):
    """Address of the first window matching any pattern, class before title."""
    compiled = [re.compile(r"\b" + re.escape(pattern) + r"\b", re.IGNORECASE) for pattern in patterns if pattern]
    for field in ("class", "initialClass", "title"):
        for client in clients:
            if not isinstance(client, dict):
                continue
            value = client.get(field)
            if not isinstance(value, str):
                continue
            if any(pattern.search(value) for pattern in compiled):
                return str(client.get("address") or "")
    return ""


def focus(address):
    if not address:
        return False
    dispatch = "hl.dsp.focus({ window = \"address:%s\" })" % address
    for command in (["hyprctl", "dispatch", dispatch],
                    ["hyprctl", "dispatch", "focuswindow", "address:" + address]):
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            continue
        if result.returncode == 0:
            return True
    return False


def entry_fields(path):
    """Exec, StartupWMClass and Name out of a desktop entry."""
    exec_line, wm_class, name = "", "", ""
    try:
        with open(path, errors="replace") as handle:
            for line in handle:
                if line.startswith("Exec=") and not exec_line:
                    exec_line = line[5:].strip()
                elif line.startswith("StartupWMClass=") and not wm_class:
                    wm_class = line[len("StartupWMClass="):].strip()
                elif line.startswith("Name=") and not name:
                    name = line[5:].strip()
    except OSError:
        pass
    return exec_line, wm_class, name


def active_window():
    """The address of the focused window, or "" when it cannot be read."""
    if not shutil.which("hyprctl"):
        return ""
    try:
        result = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=10)
        return str(json.loads(result.stdout or "{}").get("address") or "")
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""


def type_keys(*arguments):
    if not shutil.which("wtype"):
        return False
    try:
        return subprocess.run(["wtype", *arguments], capture_output=True, timeout=15).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def select_bot(address, name):
    """Switch the focused Rakazo window to a bot through its command palette.

    Rakazo's own palette hotkey is Ctrl+K and the search field filters the roster,
    so the name has to be unique enough to rank first. Escape first: a palette the
    user left open would otherwise be closed by our Ctrl+K and the name would land
    in whatever has focus - which is why nothing is typed unless the window we are
    about to drive is verifiably the focused one.
    """
    if not name or not address:
        return False
    if active_window() != address:
        return False
    if not type_keys("-k", "Escape"):
        return False
    time.sleep(KEYSTROKE_GAP)
    type_keys("-M", "ctrl", "-k", "k", "-m", "ctrl")
    time.sleep(KEYSTROKE_GAP)
    type_keys("-d", "60", name)
    time.sleep(KEYSTROKE_GAP)
    type_keys("-k", "Return")
    return True


def web_app_for(host, directory):
    """The launcher for this address, as (desktop id, Exec).

    Rakazo can be installed two ways and both are launchers worth using instead of
    a fresh browser tab:

      Exec=omarchy-launch-webapp https://host   (Omarchy's Install > Web App)
      Exec=chrome --app=https://host            (a browser shortcut, which also
                                                 sets StartupWMClass=chrome-host__-Default)

    A Chrome PWA install keeps an opaque app id instead of the address, so its
    window class is matched - and nothing is matched on the entry's name, because
    a launcher that merely mentions Rakazo is not necessarily one that opens it.
    """
    if not host:
        return "", ""
    try:
        entries = sorted(name for name in os.listdir(directory) if name.endswith(".desktop"))
    except OSError:
        return "", ""
    ranked = []
    for name in entries:
        exec_line, wm_class, _ = entry_fields(os.path.join(directory, name))
        if not exec_line:
            continue
        addresses = re.findall(r"https?://[^\s\"']+", exec_line)
        opens_it = any(host_of(address) == host for address in addresses) and (
            "--app=" in exec_line or re.search(r"(^|[\s/])omarchy-launch-webapp\b", exec_line))
        if opens_it:
            ranked.append((2, name, exec_line))
        elif wm_class and host in wm_class.lower():
            ranked.append((1, name, exec_line))
    if not ranked:
        return "", ""
    ranked.sort(key=lambda item: (-item[0], item[1]))
    _, name, exec_line = ranked[0]
    return name[:-len(".desktop")], exec_line


def launch_web_app(identifier, line):
    if identifier and shutil.which("gtk-launch"):
        try:
            if subprocess.run(["gtk-launch", identifier], capture_output=True, timeout=15).returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    if not line:
        return False
    try:
        subprocess.run(shlex.split(line), start_new_session=True, capture_output=True, timeout=15)
        return True
    except (OSError, ValueError, subprocess.SubprocessError):
        return False


def open_as_web_app(url):
    """A web app window with no launcher installed, the way Omarchy does it."""
    launcher = shutil.which("omarchy-launch-webapp")
    if not launcher:
        return False
    try:
        return subprocess.run([launcher, url], capture_output=True, timeout=15).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def open_in_browser(url):
    opener = shutil.which("xdg-open") or shutil.which("omarchy-launch-browser")
    if not opener:
        return False
    try:
        subprocess.run([opener, url], start_new_session=True, capture_output=True, timeout=15)
        return True
    except (OSError, subprocess.SubprocessError):
        return False


def parse_arguments(arguments):
    options = {"url": "", "prefer": "auto", "patterns": [], "select": ""}
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in ("--prefer", "--pattern", "--select"):
            if index + 1 >= len(arguments):
                raise ValueError("%s needs a value" % argument)
            if argument == "--prefer":
                if arguments[index + 1] not in ("auto", "web-app", "browser"):
                    raise ValueError("--prefer takes auto, web-app or browser")
                options["prefer"] = arguments[index + 1]
            elif argument == "--select":
                options["select"] = arguments[index + 1]
            else:
                options["patterns"].append(arguments[index + 1])
            index += 2
            continue
        if argument.startswith("--"):
            raise ValueError("unknown argument %s" % argument)
        if options["url"]:
            raise ValueError("expected one address")
        options["url"] = argument
        index += 1
    if not options["url"]:
        raise ValueError("usage: rakabot-open [--prefer auto|web-app|browser] <address>")
    return options


def main():
    try:
        options = parse_arguments(sys.argv[1:])
    except ValueError as error:
        sys.stderr.write("rakabot-open: %s\n" % error)
        return 1

    url, host = options["url"], host_of(options["url"])
    if "://" not in url:
        # A bare word is a typo, not an address; a bare hostname is fine.
        if "." not in url.split("/")[0] or " " in url:
            sys.stderr.write("rakabot-open: %s is not an address (try https://rakazo.example)\n" % url)
            return 1
        url = "https://" + url
    if not host:
        sys.stderr.write("rakabot-open: %s is not an address\n" % options["url"])
        return 1
    patterns = [host, *DESKTOP_APP_CLASSES, *options["patterns"]]
    directory = applications_dir()

    if options["prefer"] == "auto":
        address = find_window(windows(), patterns)
        if address and focus(address):
            if options["select"]:
                if select_bot(address, options["select"]):
                    print("focused the open Rakazo window (%s) and switched to %s"
                          % (address, options["select"]))
                else:
                    print("focused the open Rakazo window (%s); could not switch to %s"
                          % (address, options["select"]))
            else:
                print("focused the open Rakazo window (%s)" % address)
            return 0

        identifier, line = web_app_for(host, directory)
        if identifier and launch_web_app(identifier, line):
            print("launched the Rakazo web app (%s)" % identifier)
            return 0

    elif options["prefer"] == "web-app":
        identifier, line = web_app_for(host, directory)
        if identifier and launch_web_app(identifier, line):
            print("launched the Rakazo web app (%s)" % identifier)
            return 0
        if open_as_web_app(url):
            print("opened %s as a web app window" % host)
            return 0
        sys.stderr.write("rakabot-open: no way to open a web app window here\n")
        return 1

    if open_in_browser(url):
        print("opened %s in the browser" % host)
        return 0
    sys.stderr.write("rakabot-open: nothing could open %s\n" % url)
    return 1


if __name__ == "__main__":
    sys.exit(main())
