#!/usr/bin/env python3
# rakabot-setup - point the plugin at a Rakazo server and store a session token.
#
#   rakabot-setup --url https://rakazo.example
#   rakabot-setup --url https://rakazo.example --token-file ~/rakazo-token
#   rakabot-setup --url https://rakazo.example --token-stdin < token.txt
#   rakabot-setup --url https://rakazo.example --check
#
# With no token source this signs in over Rakazo's own Better Auth endpoint,
# asking for the password on the terminal. The password is never passed as an
# argument, never written to disk and never printed. What lands on disk is the
# session token, in a 0600 file, plus the server address in config.json.
#
# There is deliberately no `--token`. A secret on a command line is readable from
# /proc/<pid>/cmdline, which is world-readable, so while the setup runs any
# process on the machine can read the token straight out of it. Pass it in a
# protected file (--token-file), on stdin (--token-stdin), in the environment, or
# let the setup sign in and obtain one.
#
# The address has to be https://: the session token travels in every request, and
# the password travels during sign-in. Plain http:// is accepted only for a
# loopback address, where the traffic never reaches a network.
#
# The token is a Rakazo session: revoke it by signing that session out, and treat
# it like any other credential on this machine.
import getpass
import ipaddress
import json
import os
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = "~/.config/rakabot"


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse redirects rather than following them.

    urllib follows a 3xx to another host and carries the Authorization header
    along with it, which would hand the session token to whoever answered. A
    Rakazo server has no reason to redirect an API call, so a 3xx is an error.
    """

    def redirect_request(self, request, fp, code, msg, headers, newurl):
        return None


def http_opener():
    return urllib.request.build_opener(NoRedirect)


def config_path():
    return os.path.expanduser(os.environ.get("RAKABOT_CONFIG") or os.path.join(CONFIG_DIR, "config.json"))


def token_path():
    return os.path.expanduser(os.path.join(CONFIG_DIR, "token"))


def fail(message):
    sys.stderr.write("rakabot-setup: %s\n" % message)
    return 1


def is_loopback(host):
    if not host:
        return False
    if host.lower() == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def url_problem(url):
    """An error string when secrets must not be sent to this address, else ""."""
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in ("http", "https"):
        return "the address must start with https:// (or http:// for a loopback server)"
    if parts.scheme == "https":
        return ""
    if is_loopback(parts.hostname):
        return ""
    return ("refusing plain http:// to %s: the session token travels in every request "
            "and would be readable on the network. Use https://, or http://127.0.0.1 "
            "for a server on this machine." % (parts.hostname or url))


def post(base_url, path, payload, headers=None, timeout=20):
    body = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(base_url + path, data=body, method="POST")
    request.add_header("content-type", "application/json")
    for name, value in (headers or {}).items():
        request.add_header(name, value)
    return http_opener().open(request, timeout=timeout)


def read_token(response, body):
    for header in ("set-auth-token", "x-auth-token"):
        token = response.headers.get(header)
        if token:
            return token.strip()
    try:
        parsed = json.loads(body or "{}")
    except ValueError:
        parsed = {}
    if isinstance(parsed, dict) and isinstance(parsed.get("token"), str):
        return parsed["token"].strip()
    cookies = response.headers.get("set-cookie") or ""
    for part in cookies.split(";"):
        name, _, value = part.strip().partition("=")
        if name in ("better-auth.session_token", "__Secure-better-auth.session_token") and value:
            return urllib.parse.unquote(value)
    return ""


def sign_in(base_url, email, password):
    try:
        response = post(base_url, "/api/auth/sign-in/email", {"email": email, "password": password})
    except urllib.error.HTTPError as error:
        detail = error.read(4096).decode("utf-8", "replace")
        try:
            message = json.loads(detail).get("message") or detail
        except ValueError:
            message = detail
        return "", "sign-in failed: HTTP %s %s" % (error.code, str(message).strip()[:200])
    except urllib.error.URLError as error:
        return "", "cannot reach %s (%s)" % (base_url, error.reason)
    body = response.read(65536).decode("utf-8", "replace")
    token = read_token(response, body)
    if not token:
        return "", "signed in, but the reply carried no session token (is the bearer plugin enabled?)"
    return token, ""


def probe(base_url, token):
    """One read against the API, so a bad token is caught here, not in the bar."""
    try:
        response = post(base_url, "/rpc/bots/list", {"json": {}},
                        {"authorization": "Bearer " + token}, timeout=15)
    except urllib.error.HTTPError as error:
        if error.code == 401:
            return None, "the token was rejected (401)"
        return None, "the server answered HTTP %s" % error.code
    except urllib.error.URLError as error:
        return None, "cannot reach %s (%s)" % (base_url, error.reason)
    try:
        payload = json.loads(response.read(4 * 1024 * 1024).decode("utf-8", "replace"))
    except ValueError:
        return None, "the server answered with something that is not JSON"
    bots = (payload or {}).get("json")
    if not isinstance(bots, list):
        return None, "the server did not return a bot list"
    return bots, ""


def read_token_file(path):
    """Read a token from a file only its owner can read."""
    expanded = os.path.expanduser(path)
    try:
        info = os.stat(expanded)
    except OSError as error:
        return "", "cannot read %s (%s)" % (expanded, error.strerror or error)
    if not stat.S_ISREG(info.st_mode):
        return "", "%s is not a regular file" % expanded
    if info.st_uid != os.getuid():
        return "", "%s is not owned by you" % expanded
    if info.st_mode & 0o077:
        return "", ("%s is readable by other users (mode %s) - run `chmod 600 %s`"
                    % (expanded, oct(info.st_mode & 0o777)[2:], expanded))
    try:
        with open(expanded, "r", encoding="utf-8") as handle:
            token = handle.read().strip()
    except OSError as error:
        return "", "cannot read %s (%s)" % (expanded, error.strerror or error)
    if not token:
        return "", "%s is empty" % expanded
    return token, ""


def read_token_stdin():
    if sys.stdin.isatty():
        return "", "--token-stdin needs the token piped in, not a terminal"
    token = sys.stdin.readline().strip()
    if not token:
        return "", "no token arrived on standard input"
    return token, ""


def write_credentials(base_url, token):
    directory = os.path.dirname(config_path())
    os.makedirs(directory, mode=0o700, exist_ok=True)
    path = token_path()
    # Create with the mode already set, so the token is never briefly readable.
    handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(handle, "w") as stream:
        stream.write(token + "\n")
    os.chmod(path, 0o600)
    config = {"url": base_url, "tokenFile": path, "interval": 5}
    with open(config_path(), "w") as stream:
        json.dump(config, stream, indent=2, sort_keys=True)
        stream.write("\n")
    return path


def parse_arguments(arguments):
    options = {"url": "", "token": "", "token_file": "", "token_stdin": False,
               "email": "", "check": False}
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--check":
            options["check"] = True
            index += 1
            continue
        if argument == "--token-stdin":
            options["token_stdin"] = True
            index += 1
            continue
        if argument == "--token":
            raise ValueError("--token is gone on purpose: an argument is readable from "
                             "/proc/<pid>/cmdline by every process on this machine. Use "
                             "--token-file <path>, --token-stdin, or RAKABOT_TOKEN")
        if argument in ("--url", "--token-file", "--email"):
            if index + 1 >= len(arguments):
                raise ValueError("%s needs a value" % argument)
            options[argument[2:].replace("-", "_")] = arguments[index + 1]
            index += 2
            continue
        raise ValueError("unknown argument %s" % argument)
    if not options["url"]:
        raise ValueError("--url is required (for example https://rakazo.example)")
    options["url"] = options["url"].rstrip("/")
    problem = url_problem(options["url"])
    if problem:
        raise ValueError(problem)
    return options


def main():
    try:
        options = parse_arguments(sys.argv[1:])
    except ValueError as error:
        return fail("%s\nusage: rakabot-setup --url <server> [--token-file <path>] "
                    "[--token-stdin] [--email <email>] [--check]" % error)

    base_url = options["url"]
    token = os.environ.get("RAKABOT_TOKEN", "").strip()
    if not token and options["token_file"]:
        token, error = read_token_file(options["token_file"])
        if error:
            return fail(error)
    if not token and options["token_stdin"]:
        token, error = read_token_stdin()
        if error:
            return fail(error)

    if not token:
        email = options["email"]
        try:
            if not email:
                email = input("Rakazo email: ").strip()
            if not email:
                return fail("an email is needed to sign in")
            password = getpass.getpass("Rakazo password (not stored): ")
        except (EOFError, KeyboardInterrupt):
            return fail("cancelled - no terminal to read the password from")
        if not password:
            return fail("no password given")
        token, error = sign_in(base_url, email, password)
        del password
        if error:
            return fail(error)
        print("signed in as %s" % email)

    if not options["check"]:
        path = write_credentials(base_url, token)
        print("wrote %s and %s" % (config_path(), path))
    bots, error = probe(base_url, token)
    if error:
        return fail(error)
    print("%s answered: %d bot%s in the roster"
          % (base_url, len(bots), "" if len(bots) == 1 else "s"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
